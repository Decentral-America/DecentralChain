# Mainnet-pointed local development.
#
# The Solana bridge contracts exist on mainnet only. `.env.development` targets
# testnet (network byte `!`), where the bridge contract, the wrapped assets and
# the gateway config all do not exist — so nothing about the bridge is reachable
# from the default dev config.
#
# Run with: pnpm dev --mode mainnet-local
#
# This points a local dev server at mainnet. Transactions signed here move real
# funds. Use small amounts.
VITE_APP_ENV=mainnet-local
VITE_NETWORK=mainnet
VITE_NETWORK_BYTE=?
VITE_NODE_URL=https://mainnet-node.decentralchain.io
VITE_MATCHER_URL=https://mainnet-matcher.decentralchain.io/matcher
VITE_API_URL=https://data-service.decentralchain.io
VITE_DATA_SERVICE_URL=https://data-service.decentralchain.io
VITE_EXPLORER_URL=https://decentralscan.com
# No VITE_WS_URL: mainnet has no websocket endpoint. `mainnet-ws.decentralchain.io`
# does not resolve (NXDOMAIN) — it is a plausible-looking extrapolation from the
# testnet hostname, not a real host. `.env.production` omits it for the same reason.
VITE_DEBUG=true
VITE_ENABLE_MOCKS=false
VITE_LEDGER_ENABLED=false
VITE_LOGO_REPO=Decentral-America/token-logos
VITE_SENTRY_ENABLED=false

# Public endpoint — heavily rate-limited, fine for wiring up, not for a real
# round trip. Swap in the domain-restricted Helius key before moving funds.
VITE_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
