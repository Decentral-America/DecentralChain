# DecentralExchange — Environment Variables
# Copy to .env.local and fill in values for local development.
# See .env.production / .env.testnet / .env.staging for per-environment defaults.

# ── Application ──────────────────────────────────────────────
VITE_APP_ENV=development
VITE_APP_VERSION=0.0.0
VITE_DEBUG=true
VITE_ENABLE_MOCKS=false

# ── Network ──────────────────────────────────────────────────
# mainnet = ?, testnet = !, stagenet = S
VITE_NETWORK=mainnet
VITE_NETWORK_BYTE=?

# ── Service URLs ─────────────────────────────────────────────
VITE_NODE_URL=https://mainnet-node.decentralchain.io
VITE_MATCHER_URL=https://mainnet-matcher.decentralchain.io/matcher
VITE_API_URL=https://data-service.decentralchain.io
VITE_DATA_SERVICE_URL=https://data-service.decentralchain.io
VITE_EXPLORER_URL=https://decentralscan.com

# ── Feature flags ────────────────────────────────────────────
# Ledger is not supported yet; leave off to hide the hardware-wallet option.
VITE_LEDGER_ENABLED=false

# ── Token logos ──────────────────────────────────────────────
# The PR-curated GitHub repository the exchange reads logos from, as
# "owner/name". Served through jsDelivr: the manifest from @latest, and each
# tail logo pinned to the commit sha the manifest carries. Point this at a fork
# to try a logo before it is merged upstream. Leave it blank for the default in
# src/config/index.ts.
VITE_LOGO_REPO=Decentral-America/token-logos

# ── Error Monitoring (Sentry) ────────────────────────────────
VITE_SENTRY_ENABLED=false
VITE_SENTRY_DSN=

# ── Analytics (optional) ─────────────────────────────────────
VITE_GA_MEASUREMENT_ID=
VITE_AMPLITUDE_KEY=

# ── Solana bridge ────────────────────────────────────────────
# Required. Domain-restrict this key in the Helius dashboard — the browser
# bundle publishes it, and the VITE_ prefix protects nothing.
VITE_SOLANA_RPC_URL=
