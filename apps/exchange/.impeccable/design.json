    {
      "css": ".ds-btn-primary{background:var(--color-indigo-ink, #533afd);color:#fff;border:none;border-radius:10px;min-height:44px;padding:10px 20px;font:500 15px/1 -apple-system,BlinkMacSystemFont,\"Inter Variable\",system-ui,sans-serif;letter-spacing:-0.15px;box-shadow:0 1px 2px rgba(83,58,253,0.24);cursor:pointer;transition:background-color 160ms cubic-bezier(0.32,0.72,0,1),transform 160ms cubic-bezier(0.32,0.72,0,1),box-shadow 160ms cubic-bezier(0.32,0.72,0,1)}.ds-btn-primary:hover{background:var(--color-indigo-hover, #4a34f0);box-shadow:none}.ds-btn-primary:focus-visible{outline:none;box-shadow:0 0 0 4px rgba(83,58,253,0.18)}.ds-btn-primary:active{transform:scale(0.97)}",
      "description": "The one indigo action on a surface.",
      "html": "<button class=\"ds-btn-primary\">Unlock wallet</button>",
      "kind": "button",
      "name": "Primary Button",
      "refersTo": "button-primary"
    },
    {
      "css": ".ds-btn-secondary{background:rgba(118,118,128,0.12);color:var(--text-primary, #1d1d1f);border:1px solid transparent;border-radius:10px;min-height:44px;padding:10px 20px;font:500 15px/1 -apple-system,BlinkMacSystemFont,\"Inter Variable\",system-ui,sans-serif;cursor:pointer;transition:background-color 160ms cubic-bezier(0.32,0.72,0,1),transform 160ms cubic-bezier(0.32,0.72,0,1)}.ds-btn-secondary:hover{background:rgba(118,118,128,0.18)}.ds-btn-secondary:focus-visible{outline:none;box-shadow:0 0 0 4px rgba(83,58,253,0.18)}.ds-btn-secondary:active{transform:scale(0.97)}",
      "description": "Borderless control-fill button for the non-primary action.",
      "html": "<button class=\"ds-btn-secondary\">Open Trade</button>",
      "kind": "button",
      "name": "Secondary Button",
      "refersTo": "button-secondary"
    },
    {
      "css": ".ds-seg{display:inline-grid;grid-auto-flow:column;grid-auto-columns:1fr;gap:2px;padding:2px;border-radius:10px;background:rgba(118,118,128,0.12)}.ds-seg-opt{all:unset;cursor:pointer;padding:7px 16px;border-radius:8px;font:500 13px/18px -apple-system,BlinkMacSystemFont,\"Inter Variable\",system-ui,sans-serif;letter-spacing:-0.01em;text-align:center;color:var(--text-secondary, #6e6e73);transition:color 160ms cubic-bezier(0.32,0.72,0,1),background-color 200ms cubic-bezier(0.32,0.72,0,1)}.ds-seg-opt:hover{color:var(--text-primary, #1d1d1f)}.ds-seg-on{background:#fff;color:var(--text-primary, #1d1d1f);box-shadow:0 1px 2px rgba(0,0,0,0.08),0 3px 8px rgba(0,0,0,0.06)}.ds-seg-opt:focus-visible{box-shadow:inset 0 0 0 2px var(--color-indigo-ink, #533afd)}",
      "description": "Signature: a raised thumb that springs between options (static snapshot).",
      "html": "<div class=\"ds-seg\" role=\"radiogroup\" aria-label=\"Range\"><button class=\"ds-seg-opt\" role=\"radio\" aria-checked=\"false\">1D</button><button class=\"ds-seg-opt ds-seg-on\" role=\"radio\" aria-checked=\"true\">1W</button><button class=\"ds-seg-opt\" role=\"radio\" aria-checked=\"false\">1M</button><button class=\"ds-seg-opt\" role=\"radio\" aria-checked=\"false\">1Y</button></div>",
      "kind": "custom",
      "name": "Segmented Control",
      "refersTo": "segmented-track"
    },
    {
      "css": ".ds-ilf{position:relative;display:block;width:320px;border-radius:10px;border:1px solid var(--border-strong, #d2d2d7);background:#fff;transition:border-color 160ms cubic-bezier(0.32,0.72,0,1),box-shadow 160ms cubic-bezier(0.32,0.72,0,1)}.ds-ilf:hover{border-color:#b0b0b8}.ds-ilf-input{display:block;width:100%;box-sizing:border-box;height:54px;padding:24px 14px 8px;border:0;border-radius:10px;background:transparent;font:400 16px/22px -apple-system,BlinkMacSystemFont,\"Inter Variable\",system-ui,sans-serif;color:var(--text-primary, #1d1d1f);outline:none}.ds-ilf-label{position:absolute;left:14px;top:16px;font:400 16px/22px -apple-system,BlinkMacSystemFont,\"Inter Variable\",system-ui,sans-serif;color:var(--text-secondary, #6e6e73);transform-origin:0 0;pointer-events:none;transition:transform 240ms cubic-bezier(0.32,0.72,0,1)}.ds-ilf:focus-within{border-color:var(--color-indigo-ink, #533afd);box-shadow:0 0 0 3px rgba(83,58,253,0.45)}.ds-ilf:focus-within .ds-ilf-label,.ds-ilf-input:not(:placeholder-shown)+.ds-ilf-label{transform:translateY(-9px) scale(0.75)}",
      "description": "The form vocabulary: the label rests inside and lifts to the top edge on focus.",
      "html": "<label class=\"ds-ilf\"><input class=\"ds-ilf-input\" placeholder=\" \" /><span class=\"ds-ilf-label\">Password</span></label>",
      "kind": "input",
      "name": "Inset-Label Field",
      "refersTo": "inset-label-field"
    },
    {
      "css": ".ds-search{display:flex;align-items:center;gap:6px;min-height:40px;width:320px;padding:0 4px 0 10px;border-radius:10px;background:rgba(118,118,128,0.12);color:var(--text-secondary, #6e6e73);transition:box-shadow 160ms cubic-bezier(0.32,0.72,0,1)}.ds-search:focus-within{box-shadow:0 0 0 3px rgba(83,58,253,0.45)}.ds-search-input{flex:1;min-width:0;height:40px;border:0;outline:none;background:transparent;font:400 16px -apple-system,BlinkMacSystemFont,\"Inter Variable\",system-ui,sans-serif;letter-spacing:-0.01em;color:var(--text-primary, #1d1d1f)}.ds-search-input::placeholder{color:var(--text-secondary, #6e6e73);opacity:1}",
      "description": "The only search style: a borderless control-fill well.",
      "html": "<div class=\"ds-search\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"11\" cy=\"11\" r=\"8\"/><path d=\"m21 21-4.3-4.3\"/></svg><input class=\"ds-search-input\" type=\"search\" placeholder=\"Search assets\" aria-label=\"Search assets\" /></div>",
      "kind": "input",
      "name": "Search Field",
      "refersTo": "search-field"
    },
    {
      "css": ".ds-rail{display:inline-flex;gap:2px;padding:3px;border-radius:9999px;background:rgba(118,118,128,0.12)}.ds-rail-tab{padding:9px 16px;border-radius:9999px;font:500 13px/1 -apple-system,BlinkMacSystemFont,\"Inter Variable\",system-ui,sans-serif;color:var(--text-secondary, #6e6e73);text-decoration:none;white-space:nowrap;transition:color 200ms cubic-bezier(0.32,0.72,0,1),transform 160ms cubic-bezier(0.32,0.72,0,1)}.ds-rail-tab:hover{color:var(--text-primary, #1d1d1f)}.ds-rail-tab:active{transform:scale(0.97)}.ds-rail-tab:focus-visible{outline:3px solid rgba(83,58,253,0.45);outline-offset:2px}.ds-rail-on{background:#fff;color:var(--text-primary, #1d1d1f);box-shadow:0 1px 2px rgba(0,0,0,0.08),0 3px 8px rgba(0,0,0,0.06)}",
      "description": "Centred destinations in a pill track; the current one rides a raised pill.",
      "html": "<nav class=\"ds-rail\" aria-label=\"Primary\"><a class=\"ds-rail-tab ds-rail-on\" aria-current=\"page\" href=\"#\">Dashboard</a><a class=\"ds-rail-tab\" href=\"#\">Portfolio</a><a class=\"ds-rail-tab\" href=\"#\">Trade</a><a class=\"ds-rail-tab\" href=\"#\">Swap</a></nav>",
      "kind": "nav",
      "name": "Top Navigation Rail",
      "refersTo": "nav-rail"
    },
    {
      "css": ".ds-group{width:360px;border-radius:16px;overflow:hidden;background:var(--surface-canvas, #fff);box-shadow:0 1px 2px rgba(0,0,0,0.04),0 4px 16px rgba(0,0,0,0.05);font-family:-apple-system,BlinkMacSystemFont,\"Inter Variable\",system-ui,sans-serif;font-feature-settings:\"tnum\" on}.ds-row{position:relative;display:flex;align-items:center;gap:12px;min-height:60px;padding:10px 16px;cursor:pointer;transition:background-color 160ms cubic-bezier(0.32,0.72,0,1)}.ds-row:hover{background:rgba(118,118,128,0.12)}.ds-row+.ds-row::before{content:\"\";position:absolute;top:0;left:68px;right:0;height:1px;background:var(--border-default, #e8e8ed);transform:scaleY(0.5)}.ds-av{display:grid;place-items:center;width:40px;height:40px;border-radius:50%;background:rgba(118,118,128,0.12);font-weight:600;font-size:16px}.ds-body,.ds-fig{display:flex;flex-direction:column;gap:2px}.ds-body{flex:1}.ds-fig{align-items:flex-end}.ds-t{font-size:17px;line-height:22px;font-weight:500;color:var(--text-primary, #1d1d1f)}.ds-s{font-size:13px;line-height:18px;color:var(--text-secondary, #6e6e73)}.ds-up{font-size:13px;color:var(--color-buy, #1d7f39)}.ds-down{font-size:13px;color:var(--color-sell, #d70015)}",
      "description": "One lifted surface per group; hairlines inset past the avatar; figures right-aligned in tabular numerals.",
      "html": "<div class=\"ds-group\"><div class=\"ds-row\"><span class=\"ds-av\">D</span><span class=\"ds-body\"><span class=\"ds-t\">DecentralCoin</span><span class=\"ds-s\">DCC</span></span><span class=\"ds-fig\"><span class=\"ds-t\">1,204.50</span><span class=\"ds-up\">+2.41%</span></span></div><div class=\"ds-row\"><span class=\"ds-av\">C</span><span class=\"ds-body\"><span class=\"ds-t\">CR Coin</span><span class=\"ds-s\">CRC</span></span><span class=\"ds-fig\"><span class=\"ds-t\">88.00</span><span class=\"ds-down\">-0.37%</span></span></div></div>",
      "kind": "card",
      "name": "Grouped Inset List",
      "refersTo": "grouped-list-row"
    },
    {
      "css": ".ds-pill{display:inline-flex;align-items:center;gap:6px;padding:3px 10px;border-radius:9999px;font:500 12px/18px -apple-system,BlinkMacSystemFont,\"Inter Variable\",system-ui,sans-serif;color:var(--color-success, #1d7f39);background:color-mix(in srgb,var(--color-success, #1d7f39) 10%,transparent)}.ds-dot{width:7px;height:7px;border-radius:50%;background:currentColor}",
      "description": "Pill with a live dot; the tone at 10% as its background.",
      "html": "<span class=\"ds-pill\"><span class=\"ds-dot\"></span>Mainnet</span>",
      "kind": "chip",
      "name": "Status Pill",
      "refersTo": "status-pill"
    },
    {
      "css": ".ds-soon{display:grid;grid-template-columns:32px minmax(0,1fr);column-gap:12px;align-items:start;width:440px;padding:16px 20px;border-radius:16px;background:var(--color-warning-surface, #fff6ea);font-family:-apple-system,BlinkMacSystemFont,\"Inter Variable\",system-ui,sans-serif}.ds-soon-glyph{display:flex;align-items:center;justify-content:center;width:32px;height:32px;border-radius:50%;background:rgba(255,159,10,0.18);color:var(--color-warning, #a35200)}.ds-soon-t{display:block;font-size:15px;font-weight:600;letter-spacing:-0.15px;color:var(--text-primary, #1d1d1f)}.ds-soon-d{display:block;margin-top:2px;font-size:13px;line-height:1.45;color:var(--text-secondary, #6e6e73)}",
      "description": "The notice comes first; the unfinished preview sits inert beneath it.",
      "html": "<div class=\"ds-soon\" role=\"status\"><span class=\"ds-soon-glyph\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><path d=\"M12 6v6l4 2\"/></svg></span><span><span class=\"ds-soon-t\">Swapping is not live yet</span><span class=\"ds-soon-d\">Orders can be placed against the live order book on Trade in the meantime.</span></span></div>",
      "kind": "card",
      "name": "ComingSoon Notice",
      "refersTo": "coming-soon-notice"
    },
    {
      "css": ".ds-tile{all:unset;box-sizing:border-box;display:flex;flex-direction:column;justify-content:space-between;gap:10px;width:200px;min-height:72px;padding:12px;border-radius:14px;cursor:pointer;background:rgba(118,118,128,0.1);color:var(--text-primary, #1d1d1f);font-family:-apple-system,BlinkMacSystemFont,\"Inter Variable\",system-ui,sans-serif;transition:background-color 160ms cubic-bezier(0.32,0.72,0,1),transform 160ms cubic-bezier(0.32,0.72,0,1)}.ds-tile:hover{background:rgba(118,118,128,0.17)}.ds-tile:active{transform:scale(0.97)}.ds-tile:focus-visible{box-shadow:0 0 0 3px var(--color-lavender-border, #cdc6ff)}.ds-tile-g{display:grid;place-items:center;width:28px;height:28px;border-radius:50%;background:#fff;color:var(--color-indigo-ink, #533afd);box-shadow:0 1px 2px rgba(0,0,0,0.05),0 1px 1px rgba(0,0,0,0.03)}.ds-tile-l{font-size:14px;font-weight:500;line-height:18px}",
      "description": "Pressable quick action beside the balance hero.",
      "html": "<button class=\"ds-tile\"><span class=\"ds-tile-g\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M7 17 17 7\"/><path d=\"M7 7h10v10\"/></svg></span><span class=\"ds-tile-l\">Receive</span></button>",
      "kind": "button",
      "name": "Action Tile",
      "refersTo": "action-tile"
    }
