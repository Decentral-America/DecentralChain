# Solana RPC. Public endpoint — rate-limited, no SLA, not for production use.
# The bridge is mainnet-only, so it is unreachable from this stagenet config;
# this value exists to satisfy the build guard in vite.config.ts. If the bridge
# ever serves stagenet, swap in a domain-restricted Helius key — the browser
# bundle publishes whatever is set here.
VITE_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
