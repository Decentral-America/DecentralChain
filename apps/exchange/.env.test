# Test-environment override (vitest runs Vite in "test" mode).
#
# Pinned to mainnet regardless of what .env.local points the dev server at:
# src/services/__tests__/tokenFilters.test.ts and
# src/config/__tests__/networkConfig.test.ts assert against the static
# mainnet fixture data (known BTC/CRC asset IDs, mainnet URLs) baked into
# src/services/tokenFilters.ts and src/configs/mainnet.json. Changing this
# breaks those tests — if the app's default network ever changes, update the
# fixtures deliberately instead of letting .env.local leak into test runs.
VITE_NETWORK=mainnet
VITE_NETWORK_BYTE=?
