# Security headers for every response. Cloudflare Pages serves this file; the
# nginx configs in this app are not in the production path.
#
# Cloudflare merges every rule whose pattern matches a request (a repeated
# header is comma-joined), so nothing set on /* may be set again on a narrower
# pattern. That is why /* sets no Cache-Control: HTML gets Pages' default
# (public, max-age=0, must-revalidate) and hashed assets keep a clean
# "immutable". scripts/verifyHeaders.js enforces all of this on dist/_headers.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-eval' blob: https://s3.tradingview.com https://*.tradingview.com; worker-src 'self' blob:; style-src 'self' 'unsafe-inline' https://s3.tradingview.com https://*.tradingview.com; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://*.decentralchain.io wss://*.decentralchain.io https://api-production-c9a68.up.railway.app https://amm-indexer-production.up.railway.app https://api.mainnet-beta.solana.com wss://api.mainnet-beta.solana.com https://*.helius-rpc.com wss://*.helius-rpc.com https://s3.tradingview.com https://*.tradingview.com https://cdn.jsdelivr.net https://*.ingest.de.sentry.io; frame-src 'self' https://connect.solflare.com https://s3.tradingview.com https://*.tradingview.com https://www.tradingview-widget.com https://s.tradingview.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(self), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin

# Hashed assets — cache forever; the content hash guarantees freshness.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Locale files are versioned via ?v= — short cache so updates reach users.
/locales/*
  Cache-Control: public, max-age=3600, must-revalidate
