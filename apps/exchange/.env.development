# Development Environment Configuration (TestNet)
#
# `pnpm dev` runs Vite in mode "development", which loads this file *after*
# .env.local — so this wins for any key both define. This exchange targets
# testnet only right now; keep this in sync with .env.testnet, not mainnet.
VITE_APP_ENV=development
VITE_NETWORK=testnet
VITE_NETWORK_BYTE=!
VITE_NODE_URL=https://testnet-node.decentralchain.io
VITE_MATCHER_URL=https://testnet-matcher.decentralchain.io/matcher
VITE_API_URL=https://testnet-data-service.decentralchain.io
VITE_DATA_SERVICE_URL=https://testnet-data-service.decentralchain.io
VITE_EXPLORER_URL=https://testnet.decentralscan.com
VITE_WS_URL=wss://testnet-ws.decentralchain.io/ws
VITE_DEBUG=true
VITE_ENABLE_MOCKS=false
VITE_LEDGER_ENABLED=false
VITE_SENTRY_ENABLED=false

# Solana RPC. Public endpoint — rate-limited, testing only.
# The bridge is mainnet-only, so it is unreachable from this testnet config;
# use `pnpm dev --mode mainnet-local` to exercise it.
VITE_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
