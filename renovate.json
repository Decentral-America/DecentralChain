{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "abandonmentThreshold": "2 years",
  "baseBranchPatterns": ["main"],
  "customManagers": [
    {
      "customType": "regex",
      "datasourceTemplate": "maven",
      "depNameTemplate": "org.web3j:core",
      "description": "packages/ride/project/Dependencies.scala builds web3j and sttp3 coordinates through helper functions (web3jModule/sttp3Module). Renovate's sbt parser cannot resolve the module name and looks up `org.web3j:undefined` / `com.softwaremill.sttp.client3:undefined_3`, so the shared version string is tracked here instead.",
      "managerFilePatterns": ["/^packages/ride/project/Dependencies\\.scala$/"],
      "matchStrings": ["\"org\\.web3j\" % module % \"(?<currentValue>[^\"]+)\""],
      "versioningTemplate": "maven"
    },
    {
      "customType": "regex",
      "datasourceTemplate": "maven",
      "depNameTemplate": "com.softwaremill.sttp.client3:core_3",
      "description": "See the web3j entry above: sttp3Module(module) shares one version for every sttp client3 module.",
      "managerFilePatterns": ["/^packages/ride/project/Dependencies\\.scala$/"],
      "matchStrings": [
        "\"com\\.softwaremill\\.sttp\\.client3\" %% module % \"(?<currentValue>[^\"]+)\""
      ],
      "versioningTemplate": "maven"
    }
  ],
  "extends": ["config:best-practices", ":semanticCommitTypeAll(chore)"],
  "ignoreDeps": [
    "@testing-library/webdriverio",
    "cryptocurrency-icons",
    "cytoscape-fcose",
    "dotenv-flow",
    "i18next-resources-to-backend",
    "normalize.css",
    "tiny-invariant",
    "webextension-polyfill"
  ],
  "labels": ["dependencies"],
  "lockFileMaintenance": {
    "automerge": true,
    "enabled": true,
    "schedule": ["* * * * 1"]
  },
  "osvVulnerabilityAlerts": true,
  "packageRules": [
    {
      "automerge": false,
      "dependencyDashboardApproval": true,
      "description": "Group Nx ecosystem \u2014 review manually, dashboard approval required",
      "groupName": "Nx",
      "matchPackageNames": ["nx", "@nx/**", "@nrwl/**"]
    },
    {
      "automerge": false,
      "description": "Group Biome \u2014 review manually (affects all 25 projects)",
      "groupName": "Biome",
      "matchPackageNames": ["@biomejs/biome"]
    },
    {
      "allowedVersions": ">=6.0.0 <7.0.0",
      "automerge": false,
      "dependencyDashboardApproval": true,
      "description": "Group TypeScript \u2014 keep within v6.x; v7 is a future major and must be manually adopted after evaluation",
      "groupName": "TypeScript",
      "matchPackageNames": ["typescript"]
    },
    {
      "description": "Group Vitest + coverage (used by all 25 projects via catalog)",
      "groupName": "Vitest",
      "matchPackageNames": ["vitest", "@vitest/**"]
    },
    {
      "description": "Group Vite + plugins (exchange, scanner, cubensis-connect)",
      "groupName": "Vite",
      "matchPackageNames": ["vite", "@vitejs/**"]
    },
    {
      "description": "Group tsdown (builds 21/22 SDK packages via catalog)",
      "groupName": "tsdown",
      "matchPackageNames": ["tsdown"]
    },
    {
      "description": "Group React ecosystem (exchange, scanner, cubensis-connect)",
      "groupName": "React",
      "matchPackageNames": [
        "react",
        "react-dom",
        "@types/react",
        "@types/react-dom",
        "react-router",
        "react-router-dom"
      ]
    },
    {
      "description": "Group Radix UI primitives (scanner)",
      "groupName": "Radix UI",
      "matchPackageNames": ["@radix-ui/**"]
    },
    {
      "description": "Group Sentry (exchange + scanner + cubensis-connect)",
      "groupName": "Sentry",
      "matchPackageNames": ["@sentry/**"]
    },
    {
      "description": "Group TanStack Query (exchange + scanner)",
      "groupName": "TanStack Query",
      "matchPackageNames": ["@tanstack/**"]
    },
    {
      "description": "Group Testing Library (exchange + scanner + cubensis-connect)",
      "groupName": "Testing Library",
      "matchPackageNames": ["@testing-library/**"]
    },
    {
      "description": "Group Tailwind CSS ecosystem (scanner)",
      "groupName": "Tailwind CSS",
      "matchPackageNames": ["tailwindcss", "@tailwindcss/**", "tailwind-merge", "tw-animate-css"]
    },
    {
      "description": "Group MUI (exchange)",
      "groupName": "MUI",
      "matchPackageNames": ["@mui/**", "@emotion/**"]
    },
    {
      "description": "Group Ledger HW transport (ledger package)",
      "groupName": "Ledger",
      "matchPackageNames": ["@ledgerhq/**"]
    },
    {
      "description": "Group protobuf toolchain (protobuf-schemas)",
      "groupName": "Protobuf",
      "matchPackageNames": ["protobufjs", "@bufbuild/**"]
    },
    {
      "description": "Group noble crypto libs (crypto package)",
      "groupName": "Noble crypto",
      "matchPackageNames": ["@noble/**", "@scure/**"]
    },
    {
      "description": "Group i18n (exchange + cubensis-connect)",
      "groupName": "i18next",
      "matchPackageNames": ["i18next", "react-i18next", "i18next-resources-to-backend"]
    },
    {
      "description": "Group package quality tools (all SDK packages via catalog)",
      "groupName": "Package quality tools",
      "matchPackageNames": ["publint", "@arethetypeswrong/cli", "size-limit", "@size-limit/**"]
    },
    {
      "automerge": true,
      "automergeType": "pr",
      "description": "Automerge GitHub Actions minor/patch SHA updates \u2014 Renovate keeps digests current, CI gates the merge",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch"]
    },
    {
      "automerge": true,
      "automergeType": "pr",
      "description": "Automerge non-major devDependencies (low risk)",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch"]
    },
    {
      "automerge": true,
      "automergeType": "pr",
      "description": "Automerge patch-level production dependencies",
      "matchDepTypes": ["dependencies"],
      "matchUpdateTypes": ["patch"]
    },
    {
      "dependencyDashboardApproval": true,
      "description": "Require dashboard approval for all major updates",
      "matchUpdateTypes": ["major"]
    },
    {
      "description": "Pin GitHub Actions to full SHA for supply chain security \u2014 Renovate keeps them current",
      "matchManagers": ["github-actions"],
      "pinDigests": true
    },
    {
      "description": "Pin Dockerfile and Docker Compose base images to SHA256 digests \u2014 Renovate keeps them current",
      "matchManagers": ["dockerfile", "docker-compose"],
      "pinDigests": true
    },
    {
      "description": "ed25519-axolotl is a Rust crate (packages/sdk/crypto/Cargo.toml) compiled into WASM \u2014 it is not an npm package. Update manually via Cargo.lock when the crypto package needs a rebuild.",
      "enabled": false,
      "matchPackageNames": ["ed25519-axolotl"]
    },
    {
      "description": "@decentralchain/ride-lang and ride-repl are Scala.js-compiled binaries published by our own packages/ride sbt build pipeline. They must not be auto-updated by Renovate \u2014 bump them manually after a successful sbt fullLinkJS build and npm publish.",
      "enabled": false,
      "matchPackageNames": ["@decentralchain/ride-lang", "@decentralchain/ride-repl"]
    },
    {
      "description": "The sbt parser's unresolvable helper-function entries (module name unknown); tracked by the regex customManagers instead.",
      "enabled": false,
      "matchManagers": ["sbt"],
      "matchPackageNames": ["org.web3j:undefined", "com.softwaremill.sttp.client3:undefined_3"]
    }
  ],
  "platformAutomerge": true,
  "postUpdateOptions": ["pnpmDedupe"],
  "prConcurrentLimit": 10,
  "prCreation": "not-pending",
  "prHourlyLimit": 5,
  "schedule": ["* * * * 1"],
  "timezone": "America/Costa_Rica",
  "vulnerabilityAlerts": {
    "automerge": true,
    "description": "Security vulnerability fixes \u2014 automerge immediately after CI passes",
    "enabled": true,
    "labels": ["security", "dependencies"],
    "prCreation": "immediate"
  }
}
