# DCC Testnet — e2e-blockchain test configuration
# Copy to .env to run the TypeScript suite against testnet:
#   cp .env.testnet .env && pnpm test

DCC_TEST_NODE_URL=https://testnet-node.decentralchain.io
DCC_TEST_CHAIN_ID=!
DCC_TEST_MINER_SEED=pizza walk tourist speed dress wagon link property answer sell drum random loop high paper
DCC_TEST_DS_URL=https://testnet-data-service.decentralchain.io
DCC_TEST_MATCHER_URL=https://testnet-matcher.decentralchain.io
# If DNS resolution fails locally, override with direct IP:
# DCC_TEST_MATCHER_URL=https://testnet-matcher.decentralchain.io
# DCC_TEST_API_KEY is not needed for the public testnet (the edge adds it for /peers/*).
# Set it only for a node you run yourself.
DCC_TEST_WS_URL=wss://testnet-ws.decentralchain.io/ws
DCC_TEST_NODE_ADDRESS=31RPEKcz71a3hdxt8z7qLhTpRMuRV2kUyr6
